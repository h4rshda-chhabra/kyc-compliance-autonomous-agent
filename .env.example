# ---- Backend ----
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ALLOW_ORIGINS=["http://localhost:5173"]

DATABASE_URL=postgresql+psycopg2://kyc:kyc@localhost:5432/kyc_auditor

SECRET_KEY=change-me-in-env
