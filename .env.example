# AI providers (leave blank to run without live calls)
GEMINI_API_KEY=
OPENROUTER_API_KEY=

SCHEDULER_ENABLED=true
LOG_LEVEL=INFO

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
